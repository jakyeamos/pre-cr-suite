{
  "version": 1,
  "testCommand": "corepack pnpm run coverage",
  "coveragePaths": [
    "packages/vscode-client/coverage/coverage-final.json",
    "packages/core/coverage/coverage-final.json",
    "packages/server/coverage/coverage-final.json"
  ],
  "coverageFormat": "istanbul",
  "threshold": 80,
  "checks": {
    "coverage": true,
    "security": true,
    "checklist": true
  },
  "surfaces": {
    "covered": ["packages/**"],
    "ignored": [
      ".agents/context/**",
      ".github/**",
      ".planning/**",
      ".tracker/**",
      "docs/**",
      "fixtures/**",
      "scripts/**",
      "*.md",
      "*.json",
      "*.yaml"
    ],
    "unsupported": []
  },
  "qualityAdapters": [
    {
      "name": "environment-contract",
      "command": "node scripts/check_environment_contract.mjs",
      "required": true
    }
  ]
}
