{
  "name": "@pre-cr/server",
  "version": "0.1.0",
  "description": "Language Server Protocol server for Pre-CR Suite",
  "main": "dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "require": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "pre-cr": "./dist/cli.js",
    "pre-cr-server": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-server-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "lsp",
    "language-server",
    "coverage",
    "pre-cr"
  ],
  "author": "Jakye Amos <jakyejobs@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakyeamos/pre-cr-suite",
    "directory": "packages/server"
  },
  "dependencies": {
    "@pre-cr/core": "workspace:*",
    "js-yaml": "4.3.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
