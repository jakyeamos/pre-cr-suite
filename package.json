{
  "name": "pre-cr-suite-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Coverage-first pre-PR readiness workflow for VS Code and Neovim",
  "author": "Jakye Amos <jakyejobs@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakyeamos/pre-cr-suite"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm run build:core && corepack pnpm run build:server && corepack pnpm run build:vscode",
    "build:core": "corepack pnpm --filter @pre-cr/core build",
    "build:server": "corepack pnpm --filter @pre-cr/server build",
    "build:vscode": "corepack pnpm --filter pre-cr-suite build",
    "typecheck": "node scripts/run-turbo-with-pinned-pnpm.mjs run typecheck",
    "test": "node scripts/run-turbo-with-pinned-pnpm.mjs run test",
    "test:headless-beta": "corepack pnpm run build:core && corepack pnpm run build:server && node scripts/smoke-headless-beta-gate.js",
    "lint": "node scripts/run-turbo-with-pinned-pnpm.mjs run lint",
    "package": "corepack pnpm run build && corepack pnpm --filter pre-cr-suite package",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "pnpm audit --audit-level high",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "dev": "node scripts/run-turbo-with-pinned-pnpm.mjs run dev --parallel",
    "format:check": "node scripts/aios-adoption-gates.mjs format",
    "validation": "node scripts/aios-adoption-gates.mjs validation",
    "dead-code": "node scripts/aios-adoption-gates.mjs dead-code",
    "complexity:check": "node scripts/aios-adoption-gates.mjs complexity",
    "pre-pr": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && node scripts/aios-adoption-gates.mjs validation",
    "thermo-nuclear-simplification": "node scripts/aios-adoption-gates.mjs thermo"
  },
  "devDependencies": {
    "eslint-plugin-anti-slop": "file:/Users/jakyeamos/projects/eslint-plugin-anti-slop",
    "turbo": "^2.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "@azure/msal-node": "5.3.0",
      "@typescript-eslint/typescript-estree>minimatch": "9.0.7",
      "@vscode/vsce>form-data": "4.0.6",
      "@vscode/vsce>markdown-it": "14.2.0",
      "@vscode/vsce>tmp": "0.2.7",
      "cheerio>undici": "7.28.0",
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0",
      "postcss": "8.5.15",
      "typed-rest-client>qs": "6.15.3",
      "vite": "6.4.3"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
